{
  // Deployed separately so that requests to the main site stay on static assets and never invoke a script.
  "name": "secureaiarch-www",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "routes": [{ "pattern": "www.secureaiarch.com", "custom_domain": true }]
}
