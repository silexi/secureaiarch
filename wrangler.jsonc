{
  // Static site. The apex is served here; www.secureaiarch.com is served by the redirect Worker in www/.
  "name": "secureaiarch",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "secureaiarch.com", "custom_domain": true }
  ]
}
