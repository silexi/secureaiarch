{
  // Static site. secureaiarch.com is currently served by the domain-placeholder Worker; on cutover the route moves from there to here.
  "name": "secureaiarch",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
