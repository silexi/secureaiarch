---
import type { Lang } from "../i18n";
const { lang } = Astro.props as { lang: Lang };
const L = {
  en: { user: "User request", order: "Order record", orderNote: "note: written by staff or customer", llm: "LLM", llmNote: "reads the request: intent, amount", code: "Workflow code", codeNote: "looks the order up, checks the policy on the order's own fields", fields: "amount, age,", fields2: "account;", fields3: "note not read", refund: "Paid to the order's account", approval: "Filed for a person to approve", agent: "Agent arm: the model holds issue_refund and picks the steps", agentNote: "the policy is only in the prompt", title: "Workflow topology" },
  tr: { user: "Kullanıcı talebi", order: "Sipariş kaydı", orderNote: "not: personel ya da müşteri yazar", llm: "LLM", llmNote: "talebi okur: niyet, tutar", code: "İş akışı kodu", codeNote: "siparişi sorgular, politikayı siparişin kendi alanlarıyla denetler", fields: "tutar, yaş,", fields2: "hesap;", fields3: "not okunmaz", refund: "Siparişin hesabına iade", approval: "Bir kişinin onayına gönderildi", agent: "Ajan kolu: issue_refund modelde, adımları model seçer", agentNote: "politika yalnızca prompt'ta", title: "İş akışı topolojisi" },
}[lang];
---
<figure class="diagram" tabindex="0">
<svg viewBox="0 0 450 420" role="img" aria-label={L.title}>
  <defs><marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z"/></marker></defs>
  <rect class="box untrusted" x="20" y="10" width="190" height="44" rx="8"/>
  <text x="115" y="37" text-anchor="middle">{L.user}</text>
  <rect class="box untrusted" x="240" y="10" width="190" height="52" rx="8"/>
  <text x="335" y="31" text-anchor="middle">{L.order}</text><text class="small" x="335" y="48" text-anchor="middle">{L.orderNote}</text>
  <path class="edge" d="M115,54 V94"/>
  <rect class="box" x="20" y="96" width="190" height="52" rx="8"/>
  <text x="115" y="117" text-anchor="middle">{L.llm}</text><text class="small" x="115" y="134" text-anchor="middle">{L.llmNote}</text>
  <path class="edge" d="M115,148 V196"/>
  <path class="edge" d="M335,62 V196"/>
  <text class="small" x="343" y="117">{L.fields}</text>
  <text class="small" x="343" y="131">{L.fields2}</text>
  <text class="small" x="343" y="145">{L.fields3}</text>
  <rect class="box control" x="20" y="198" width="410" height="52" rx="8"/>
  <text x="225" y="219" text-anchor="middle">{L.code}</text><text class="small" x="225" y="237" text-anchor="middle">{L.codeNote}</text>
  <path class="edge" d="M115,250 V288"/>
  <path class="edge" d="M335,250 V288"/>
  <rect class="box sink" x="20" y="290" width="190" height="40" rx="8"/>
  <text x="115" y="315" text-anchor="middle">{L.refund}</text>
  <rect class="box sink" x="240" y="290" width="190" height="40" rx="8"/>
  <text x="335" y="315" text-anchor="middle">{L.approval}</text>
  <rect class="box weak" x="20" y="352" width="410" height="52" rx="8"/>
  <text x="225" y="373" text-anchor="middle">{L.agent}</text><text class="small" x="225" y="391" text-anchor="middle">{L.agentNote}</text>
</svg>
</figure>
