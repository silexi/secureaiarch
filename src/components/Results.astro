---
import type { Lang } from "../i18n";
import ResultsStructured from "./ResultsStructured.astro";
import ResultsPermission from "./ResultsPermission.astro";
import ResultsToolBoundary from "./ResultsToolBoundary.astro";
const { lang, pattern } = Astro.props as { lang: Lang; pattern: string };
const views: Record<string, any> = { "permission-filter": ResultsPermission, "tool-boundary": ResultsToolBoundary };
const View = views[pattern] ?? ResultsStructured;
---
<View lang={lang} pattern={pattern} />
