---
import type { Lang } from "../i18n";
import ResultsStructured from "./ResultsStructured.astro";
import ResultsPermission from "./ResultsPermission.astro";
const { lang, pattern } = Astro.props as { lang: Lang; pattern: string };
---
{pattern === "permission-filter" ? <ResultsPermission lang={lang} pattern={pattern} /> : <ResultsStructured lang={lang} pattern={pattern} />}
